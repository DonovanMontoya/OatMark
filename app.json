{
  "expo": {
    "name": "OatMark",
    "slug": "oatmark",
    "scheme": "oatmark",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4EDDD",
      "dark": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#1A1410"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.donovanmontoya.oatmark"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4EDDD"
      },
      "package": "com.donovanmontoya.oatmark",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "ab55d0c6-3725-4cf8-a1ed-f9f85bd09a98"
      }
    },
    "owner": "thechromecrafter"
  }
}
